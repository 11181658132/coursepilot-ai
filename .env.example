# Never commit the real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Optional public demo vector store created by backend/scripts/setup_demo_store.py.
OPENAI_DEMO_VECTOR_STORE_ID=
DEMO_RATE_LIMIT_SALT=replace-with-a-long-random-value
KNOWLEDGE_BASE_DIR=/absolute/path/to/your/knowledge-base
INDEX_STATE_PATH=backend/data/index_state.json
FRONTEND_ORIGIN=http://localhost:3000
MAX_SEARCH_RESULTS=8
TELEMETRY_PATH=backend/data/chat_events.jsonl
CONVERSATION_DB_PATH=backend/data/coursepilot.db
# Keep these configurable because model prices can change.
OPENAI_INPUT_COST_PER_MILLION=0.10
OPENAI_OUTPUT_COST_PER_MILLION=0.50
OPENAI_FILE_SEARCH_COST_PER_THOUSAND=2.50
MAX_UPLOAD_MB=25
CHAT_REQUESTS_PER_MINUTE=12
ADMIN_REQUESTS_PER_MINUTE=30
OPENAI_MAX_RETRIES=2
OPENAI_TIMEOUT_SECONDS=60
# Select hybrid after building the local index. File Search remains the baseline.
RAG_ENGINE=file_search
RAG_DB_PATH=backend/data/rag.sqlite3
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_COST_PER_MILLION=0.02
RAG_CANDIDATE_COUNT=12
RAG_RERANK=true
RAG_CHUNK_CHARS=1600
RAG_CHUNK_OVERLAP=200
# Conservative upper limit for embedding input per indexing run, including overlap.
RAG_INDEX_MAX_EMBEDDING_TOKENS=5000000
